# /etc/warren/warrend.env: configuration of the Warren daemon, read by
# packaging/systemd/warrend.service. Flags and WARREN_* variables are
# interchangeable; the full table with defaults is in docs/self-hosting.md.
# Lines are KEY=value (systemd EnvironmentFile syntax, no `export`).

# Where the daemon listens. Keep it on loopback behind a TLS proxy (Caddy,
# Cloudflare); `:7337` binds every interface, dual-stack.
WARREN_LISTEN=127.0.0.1:7337

# Public names: api.<base>, <id>.<base>, <id>-<port>.<base>. Needs wildcard
# DNS and a wildcard certificate on the proxy. Local default: warren.localhost.
WARREN_BASE_DOMAIN=warren.example.com
WARREN_PUBLIC_SCHEME=https
WARREN_PUBLIC_PORT=443

# Everything persistent: SQLite, the signing secret, instance disks, backups.
WARREN_DATA_DIR=/var/lib/warren

# Docker OCI runtime for default instances: auto (runsc when registered, else
# runc with a warning), runsc (fail without gVisor; use this in production),
# runc, or none (no Docker: a Mac serving only mac instances).
WARREN_RUNTIME=runsc

# Tag of the built-in images (scripts/build-images.sh must use the same tag).
WARREN_IMAGE_TAG=prod

# Label reported on instances.
WARREN_REGION=local

# tracing filter, e.g. info,warren_edge=debug
WARREN_LOG=info

# Open signup (POST /v1/signup without auth, 10 per IP per hour). Turn it off
# on a public host and create workspaces through your own flow.
WARREN_SIGNUP_ENABLED=false

# Awake instances per workspace; unset means unlimited.
#WARREN_MAX_AWAKE_INSTANCES=4

# Lowest idle timeout instances may ask for (seconds).
#WARREN_MIN_IDLE_SECONDS=300

# Let instances reach RFC 1918 ranges and the host (169.254.0.0/16 stays blocked).
#WARREN_ALLOW_PRIVATE_EGRESS=false

# Egress broker (allowlist proxy and secret routes): where it listens, and the
# host:port instances use to reach it when the per-runtime default is wrong.
# `none` runs without a broker and refuses network allowlist and secrets.
#WARREN_BROKER_LISTEN=0.0.0.0:7349
#WARREN_BROKER_ADVERTISE=

# Signed-URL secret; generated into $WARREN_DATA_DIR/secret when unset.
# Rotating it invalidates every signed URL and cookie.
#WARREN_SECRET=

# Static gateway injected into registered images; found next to warrend or in
# /usr/local/bin when unset.
#WARREN_GATEWAY_BIN=/usr/local/bin/warren-gateway

# Firecracker vm instances (root, /dev/kvm): docs/vm-instances.md
#WARREN_ENABLE_FIRECRACKER=false
#WARREN_FIRECRACKER_BIN=/usr/local/bin/firecracker
#WARREN_KERNEL_IMAGE=/var/lib/warren/vmlinux

# Never in production: 5 s idle timeouts and host.docker.internal in instances.
#WARREN_DEV=false
